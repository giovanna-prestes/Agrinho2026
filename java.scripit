// Grafico de linha - preco da soja
var ctx1 = document.getElementById('graficoSoja').getContext('2d');
new Chart(ctx1, {
    type: 'line',
    data: {
        labels: ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'],
        datasets: [{
            label: 'Preco da Soja (R$/saca)',
            data: [120, 123, 127, 130, 128, 133, 136, 138, 140, 141, 143, 145],
            borderColor: '#2d6a2d',
            backgroundColor: 'rgba(45,106,45,0.15)',
            borderWidth: 3,
            pointBackgroundColor: '#f5c800',
            fill: true
        }]
    }
});

// Grafico de barras - exportacoes
var ctx2 = document.getElementById('graficoExportacoes').getContext('2d');
new Chart(ctx2, {
    type: 'bar',
    data: {
        labels: ['Soja','Carnes','Acucar','Cafe','Milho'],
        datasets: [{ // Corrigido aqui: mudado de 'atasets' para 'datasets'
            label: 'Exportacoes (R$ bilhoes)',
            data: [52, 21, 15, 11, 9],
            backgroundColor: ['#2d6a2d','#f5c800','#3a8a3a','#e0b800','#4aaa4a']
        }]
    }
});