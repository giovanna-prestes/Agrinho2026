// Seleciona o botão de alternar tema
const botao = document.getElementById('botao-tema');

// Escuta o clique no botão
botao.addEventListener('click', () => {
    // Liga ou desliga a classe 'modo-escuro' no corpo do site
    document.body.classList.toggle('modo-escuro');
    
    // Altera o texto do botão dependendo do modo ativo
    if (document.body.classList.contains('modo-escuro')) {
        botao.textContent = 'Alternar Modo Claro';
    } else {
        botao.textContent = 'Alternar Modo Escuro';
    }
});
